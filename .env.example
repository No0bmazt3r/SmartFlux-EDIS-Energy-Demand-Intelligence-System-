# Copy to .env. Never commit .env.
# Sample mode (default): no credentials, no sponsor services, real agent logic on data/sample.
SAMPLE_MODE=true
PORT=8000

# Live mode: SAMPLE_MODE=false turns on both. To run one side live on its own (for example Nightshift on
# this laptop while Zetaris runs elsewhere), leave SAMPLE_MODE=true and set DATA_MODE or LLM_MODE.
# DATA_MODE=zetaris
# LLM_MODE=nightshift

# --- Zetaris (data layer) ---
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
ZETARIS_TIMEOUT_MS=30000

# --- smartflux-pg (docker compose up smartflux-pg), the Postgres source Zetaris reads ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=smartflux
PGUSER=smartflux
PGPASSWORD=your-postgres-password
# How the Zetaris containers reach smartflux-pg (same Docker host: host.docker.internal)
PG_HOST_FOR_ZETARIS=host.docker.internal

# --- Meterless Nightshift (primary AI provider) -> NVIDIA Nemotron ---
# From WSL, 127.0.0.1 may not reach Nightshift on Windows: use the Windows host IP or mirrored networking.
# From Docker, use host.docker.internal.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
# Pinned Nemotron routes from /v1/models (not meterless/auto): fast lane = Scout, Planner; deep lane = Skeptic, Reporter
MODEL_FAST=pinned-nemotron-route-from-v1-models
MODEL_DEEP=pinned-nemotron-route-from-v1-models
NIGHTSHIFT_TIMEOUT_MS=60000
# The NVIDIA API key is NOT here: it lives in Nightshift -> Setup -> Providers.

# --- Backup AI path: NVIDIA Nemotron straight from build.nvidia.com (LLM_MODE=nvidia) ---
# Use only if Nightshift is unavailable. Get a key at build.nvidia.com (open a Nemotron model → Get API Key).
# NVIDIA_API_KEY=your-nvidia-api-key
# NVIDIA_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
# Deep lane: a larger Nemotron (e.g. Super) if your account has access; otherwise Lightning for both
# NVIDIA_MODEL_DEEP=nvidia/nemotron-3.5-lightning-30b-a3b
# NVIDIA_JSON_MODE=false
# Extra request fields, as JSON. Default turns Nemotron's thinking off, so short JSON answers are not cut off.
# NVIDIA_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# --- Record and replay ---
# LLM_RECORD=true saves every live LLM answer to LLM_CACHE_DIR. LLM_MODE=replay answers from those files offline.
# LLM_RECORD=false
# LLM_CACHE_DIR=data/sample/llm-cache

# Caps
MAX_TOOL_CALLS=30
MAX_REJECTIONS_PER_CLAIM=3
MAX_REPLANS=2
