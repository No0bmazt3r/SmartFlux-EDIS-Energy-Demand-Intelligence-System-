{
  "name": "smartflux",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "agent": "tsx apps/backend/src/cli.ts",
    "test": "node --import tsx --test \"apps/backend/src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p .",
    "zetaris:setup": "tsx scripts/zetaris-setup.ts",
    "smoke": "tsx scripts/smoke.ts",
    "data:generate": "tsx scripts/generate-data.ts --seed 1 --out data/sample && tsx scripts/generate-data.ts --seed 2 --out data/seed2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
