{
  "name": "smartflux",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "agent": "tsx apps/backend/src/cli.ts",
    "start": "tsx apps/backend/src/server.ts",
    "demo": "pnpm web:build && tsx apps/backend/src/server.ts --demo",
    "dev": "pnpm run \"/^(api:dev|web:dev)$/\"",
    "api:dev": "tsx watch --clear-screen=false apps/backend/src/server.ts",
    "live": "docker compose up -d --wait smartflux-pg && pnpm smoke && pnpm demo",
    "web:dev": "pnpm --filter @smartflux/frontend dev",
    "web:build": "pnpm --filter @smartflux/frontend build",
    "test": "node --import tsx --test \"apps/backend/src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p .",
    "zetaris:setup": "tsx scripts/zetaris-setup.ts",
    "smoke": "tsx scripts/smoke.ts",
    "eval": "tsx eval/run-eval.ts",
    "benchmark": "tsx eval/benchmark.ts",
    "examples": "tsx scripts/examples.ts",
    "data:generate": "tsx scripts/generate-data.ts --seed 1 --out data/sample && tsx scripts/generate-data.ts --seed 2 --out data/seed2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
